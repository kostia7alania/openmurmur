# Copy to .github/FUNDING.yml and replace the placeholders with REAL accounts.
#
# This file is deliberately NOT committed as FUNDING.yml: GitHub Sponsors is not
# configured for the authoring account, and a donate button pointing at an
# account that does not exist is worse than no button at all.
#
# CI fails if a committed FUNDING.yml still contains these placeholders.

github: [YOUR_GITHUB_USERNAME]
ko_fi: YOUR_KOFI_USERNAME
buy_me_a_coffee: YOUR_BMAC_USERNAME
custom: ["https://example.com/YOUR_DONATE_PAGE"]

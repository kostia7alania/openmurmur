<?xml version="1.0" encoding="UTF-8"?>
<!--
  Optional: a standalone Telegram poller.

  The main daemon already polls Telegram. Install this ONLY if you run the
  recorder elsewhere, or you will have two pollers competing for the same
  getUpdates offset.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.openmurmur.telegram</string>

    <key>ProgramArguments</key>
    <array>
        <string>__NODE_BIN__</string>
        <string>__REPO_DIR__/src/cli/main.ts</string>
        <string>telegram</string>
        <string>poll</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_DIR__</string>

    <key>RunAtLoad</key>
    <false/>
    <key>StartInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Application Support/OpenMurmur/logs/telegram.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Application Support/OpenMurmur/logs/telegram.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily digest at 23:30 local time.

  The daemon also produces a digest when it is running; this agent is a safety
  net for machines that are asleep at that hour. The digest table has a UNIQUE
  constraint on the date, so running both cannot produce two digests.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.openmurmur.digest</string>

    <key>ProgramArguments</key>
    <array>
        <string>__NODE_BIN__</string>
        <string>__REPO_DIR__/src/cli/main.ts</string>
        <string>digest</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_DIR__</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>23</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Application Support/OpenMurmur/logs/digest.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Application Support/OpenMurmur/logs/digest.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>

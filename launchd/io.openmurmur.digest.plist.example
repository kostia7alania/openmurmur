<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily digest scheduler fallback.

  The command wakes every five minutes and evaluates digest.enabled,
  digest.atLocalTime and digest.timezone from the real config. The daemon uses
  the same stable delivery identity, so both paths converge on one digest.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.openmurmur.digest</string>

    <key>ProgramArguments</key>
    <array>
        <string>__NODE_BIN__</string>
        <string>__REPO_DIR__/src/cli/main.ts</string>
        <string>digest</string>
        <string>scheduled</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_DIR__</string>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Application Support/OpenMurmur/logs/digest.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Application Support/OpenMurmur/logs/digest.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>

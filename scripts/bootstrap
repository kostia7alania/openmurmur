#!/usr/bin/env bash
# Installs everything OpenMurmur needs. Idempotent: safe to re-run.
#
# It never installs models (multi-gigabyte, and your choice) and never touches
# the Keychain. Run `pnpm openmurmur setup telegram owner|send-only` for that.
set -euo pipefail

cd "$(dirname "$0")/.."
RUNTIME_CONTRACT="$PWD/runtime-requirements.json"

bold() { printf '\033[1m%s\033[0m\n' "$1"; }
warn() { printf '\033[33m! %s\033[0m\n' "$1"; }
ok()   { printf '\033[32m✓ %s\033[0m\n' "$1"; }
die()  { printf '\033[31m✗ %s\033[0m\n' "$1" >&2; exit 1; }

bold "OpenMurmur bootstrap"
echo

[ "$(uname -s)" = "Darwin" ] || die "OpenMurmur runs on macOS only."
if [ "$(uname -m)" != "arm64" ]; then
  warn "This is not Apple Silicon. MLX needs Metal on an M-series chip; ASR will not work."
fi

# --- Node ---------------------------------------------------------------
PLUTIL=/usr/bin/plutil
[ -x "$PLUTIL" ] || die "macOS plutil is required to read the runtime contract."

CONTRACT_SCHEMA_VERSION="$($PLUTIL -extract schemaVersion raw -o - "$RUNTIME_CONTRACT" 2>/dev/null || true)"
CONTRACT_NODE_MINIMUM="$($PLUTIL -extract nodeMinimum raw -o - "$RUNTIME_CONTRACT" 2>/dev/null || true)"
CONTRACT_SQLITE_MINIMUM="$($PLUTIL -extract sqliteMinimum raw -o - "$RUNTIME_CONTRACT" 2>/dev/null || true)"
CONTRACT_PNPM_EXACT="$($PLUTIL -extract pnpmExact raw -o - "$RUNTIME_CONTRACT" 2>/dev/null || true)"
VERSION_PATTERN='^[0-9]+\.[0-9]+\.[0-9]+$'
if [ "$CONTRACT_SCHEMA_VERSION" != "1" ] ||
   ! [[ "$CONTRACT_NODE_MINIMUM" =~ $VERSION_PATTERN ]] ||
   ! [[ "$CONTRACT_SQLITE_MINIMUM" =~ $VERSION_PATTERN ]] ||
   ! [[ "$CONTRACT_PNPM_EXACT" =~ $VERSION_PATTERN ]]; then
  die "runtime-requirements.json is invalid; refusing to install a runtime from it."
fi

NODE_BIN="$(command -v node 2>/dev/null || true)"
if [ -z "$NODE_BIN" ]; then
  BREW_BIN="$(command -v brew 2>/dev/null || true)"
  [ -n "$BREW_BIN" ] || \
    die "Node >= $CONTRACT_NODE_MINIMUM is required. Install Homebrew (https://brew.sh) and re-run bootstrap."

  warn "Node >= $CONTRACT_NODE_MINIMUM not found; installing with Homebrew"
  "$BREW_BIN" install node
  BREW_NODE_PREFIX="$($BREW_BIN --prefix node 2>/dev/null || true)"
  NODE_BIN="$BREW_NODE_PREFIX/bin/node"
  [ -x "$NODE_BIN" ] || \
    die "Homebrew reported a successful Node install, but $NODE_BIN is not executable."
  hash -r
fi

if ! RUNTIME_VALUES="$("$NODE_BIN" --input-type=module - "$RUNTIME_CONTRACT" 2>&1 <<'NODE'
import { readFileSync } from 'node:fs';

const contractPath = process.argv[2];
const contract = JSON.parse(readFileSync(contractPath, 'utf8'));
const versionPattern = /^\d+\.\d+\.\d+$/;
const keys = ['nodeMinimum', 'sqliteMinimum', 'pnpmExact'];
if (contract.schemaVersion !== 1 || keys.some((key) => !versionPattern.test(contract[key]))) {
  throw new Error('invalid runtime requirements contract');
}

function compare(left, right) {
  const a = left.split('.').map(Number);
  const b = right.split('.').map(Number);
  for (let i = 0; i < Math.max(a.length, b.length); i += 1) {
    const delta = (a[i] ?? 0) - (b[i] ?? 0);
    if (delta !== 0) return delta;
  }
  return 0;
}

const sqlite = process.versions.sqlite ?? '0.0.0';
const problems = [];
if (compare(process.versions.node, contract.nodeMinimum) < 0) {
  problems.push('Node ' + process.versions.node + ' is below ' + contract.nodeMinimum);
}
if (compare(sqlite, contract.sqliteMinimum) < 0) {
  problems.push('node:sqlite ' + sqlite + ' is below ' + contract.sqliteMinimum);
}
if (problems.length > 0) {
  process.stderr.write(problems.join('; '));
  process.exit(1);
}
process.stdout.write(
  [contract.nodeMinimum, contract.sqliteMinimum, contract.pnpmExact].join('\t'),
);
NODE
)"; then
  die "Runtime requirement check failed: $RUNTIME_VALUES. Run: nvm install && nvm use"
fi
IFS=$'\t' read -r MINIMUM_NODE_VERSION MINIMUM_SQLITE_VERSION PNPM_VERSION <<< "$RUNTIME_VALUES"
if [ "$MINIMUM_NODE_VERSION" != "$CONTRACT_NODE_MINIMUM" ] ||
   [ "$MINIMUM_SQLITE_VERSION" != "$CONTRACT_SQLITE_MINIMUM" ] ||
   [ "$PNPM_VERSION" != "$CONTRACT_PNPM_EXACT" ]; then
  die "runtime-requirements.json changed while bootstrap was selecting the runtime; re-run bootstrap."
fi
ok "Node $("$NODE_BIN" -v)"

# --- pnpm ---------------------------------------------------------------
PNPM_BIN="$(command -v pnpm 2>/dev/null || true)"
ACTUAL_PNPM_VERSION=""
if [ -n "$PNPM_BIN" ]; then
  ACTUAL_PNPM_VERSION="$("$PNPM_BIN" --version 2>/dev/null || true)"
fi

if [ "$ACTUAL_PNPM_VERSION" != "$PNPM_VERSION" ]; then
  if [ -n "$ACTUAL_PNPM_VERSION" ]; then
    warn "pnpm $ACTUAL_PNPM_VERSION found; OpenMurmur requires exactly $PNPM_VERSION"
  else
    warn "pnpm $PNPM_VERSION is not installed"
  fi

  NODE_BIN_DIR="$(dirname "$NODE_BIN")"
  NPM_BIN="$NODE_BIN_DIR/npm"
  [ -x "$NPM_BIN" ] || die "npm was not found beside the validated Node runtime ($NODE_BIN). Reinstall Node $MINIMUM_NODE_VERSION or newer."

  echo "  Installing the exact package manager declared by package.json:"
  echo "    $NPM_BIN install --global pnpm@$PNPM_VERSION"
  "$NPM_BIN" install --global "pnpm@$PNPM_VERSION"
  hash -r

  PNPM_BIN="$(command -v pnpm 2>/dev/null || true)"
  [ -n "$PNPM_BIN" ] || die "pnpm $PNPM_VERSION was installed but is not on PATH. Add npm's global bin directory to PATH and re-run bootstrap."
  ACTUAL_PNPM_VERSION="$("$PNPM_BIN" --version 2>/dev/null || true)"
fi

[ "$ACTUAL_PNPM_VERSION" = "$PNPM_VERSION" ] || \
  die "pnpm ${ACTUAL_PNPM_VERSION:-unavailable} found after installation; expected exactly $PNPM_VERSION."
ok "pnpm $ACTUAL_PNPM_VERSION"

# --- FFmpeg -------------------------------------------------------------
if ! command -v ffmpeg >/dev/null 2>&1; then
  if command -v brew >/dev/null 2>&1; then
    warn "ffmpeg not found; installing with Homebrew"
    brew install ffmpeg
  else
    die "ffmpeg is required. Install Homebrew (https://brew.sh) then: brew install ffmpeg"
  fi
fi
ok "$(ffmpeg -version | head -1)"

# --- uv -----------------------------------------------------------------
if ! command -v uv >/dev/null 2>&1; then
  warn "uv not found; installing"
  curl -LsSf https://astral.sh/uv/install.sh | sh
  export PATH="$HOME/.local/bin:$PATH"
fi
ok "$(uv --version)"

# --- Dependencies -------------------------------------------------------
bold "Installing Node dependencies"
"$PNPM_BIN" install --frozen-lockfile

bold "Installing the Python audio worker (CI-safe subset)"
/usr/bin/env -u UV_PROJECT_ENVIRONMENT uv sync --project python/openmurmur_audio --inexact
ok "Python worker ready"

echo
warn "The required MLX ASR stack and model are NOT installed by default (several GB, needs Metal)."
cat <<'MLX_STEPS'
  Before doctor can report local speech readiness, run these foreground commands:

    /usr/bin/env -u UV_PROJECT_ENVIRONMENT uv sync --project python/openmurmur_audio --extra mlx

    /usr/bin/env -u UV_PROJECT_ENVIRONMENT \
      HF_ENDPOINT=https://huggingface.co HF_HUB_DISABLE_TELEMETRY=1 HF_HUB_DISABLE_IMPLICIT_TOKEN=1 \
      uv run --no-sync --project python/openmurmur_audio \
      hf download Qwen/Qwen3-ASR-1.7B \
      --include '*.json' --include '*.safetensors' --include '*.txt' --include '*.model'

  The model download contacts huggingface.co and its storage/CDN hosts, discloses
  the public model id plus ordinary HTTPS metadata, and stores about 4.4 GiB in
  the Hugging Face cache. It sends no audio, transcript, or Telegram secret.
  See docs/INSTALL.md, step 7, and PRIVACY.md for the exact boundary.

  If you skip these commands, doctor is expected to keep mlx_readiness and
  speech_detection blocking; that is not a completed local runtime.
MLX_STEPS
echo
warn "Ollama is optional. Without it you get audio and transcripts, but no summaries:"
echo "    brew install ollama && brew services start ollama && ollama pull qwen3.6:27b"
echo

bold "Next steps"
cat <<'STEPS'
  pnpm openmurmur doctor                            # verify required local readiness
  pnpm openmurmur setup --telegram-role owner       # fresh input-owner config
  pnpm openmurmur setup telegram owner              # connect the input owner
  # Or, on every output-only sibling, use the matching send-only pair:
  pnpm openmurmur setup --telegram-role send-only
  pnpm openmurmur setup telegram send-only
  pnpm openmurmur capture test                      # prove foreground PCM and check levels
  pnpm openmurmur start                             # run the daemon
STEPS

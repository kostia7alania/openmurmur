#!/bin/bash
# Binds attended release evidence to one clean, offline-verified source revision.
# Check mode is read-only; prepare also runs the repository's offline gates.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
REPO="$(cd "$SCRIPT_DIR/.." && pwd -P)"
RUNTIME_CONTRACT="$REPO/runtime-requirements.json"
MANIFEST_NAME="release-signoff-v2.json"
RECEIPT_NAME="release-verification-v1.json"
COMMIT_NAME="release-signoff-commit-v1.json"

MODE=""
EVIDENCE_DIR=""
REQUESTED_ROOT=""
STAGE_DIR=""
STAGE_DIR_ID=""

die() {
  printf 'release-signoff: %s\n' "$1" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
Usage:
  ./scripts/release-signoff --prepare --evidence-dir DIR [--root ROOT]
  ./scripts/release-signoff --check   --evidence-dir DIR [--root ROOT]

  --prepare       Run the offline repository gates, then atomically create the receipt and manifest.
  --check         Read-only: verify the receipt and manifest without rerunning repository gates.
  --evidence-dir  Existing private (0700), physical, user-owned evidence directory.
  --root          Require this exact canonical state root in both installed plists.

Neither mode changes launchd, opens the microphone, reads Keychain values, or uses the network.
Prepare runs pnpm's frozen offline install before the full Node and Python checks.
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --prepare|--check)
      [ -z "$MODE" ] || die "choose exactly one of --prepare or --check"
      MODE="${1#--}"
      shift
      ;;
    --evidence-dir)
      [ "$#" -ge 2 ] || die "--evidence-dir needs a path"
      EVIDENCE_DIR="$2"
      shift 2
      ;;
    --root)
      [ "$#" -ge 2 ] || die "--root needs a path"
      REQUESTED_ROOT="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      die "unknown option: $1"
      ;;
  esac
done

[ -n "$MODE" ] || { usage >&2; die "choose --prepare or --check"; }
[ -n "$EVIDENCE_DIR" ] || die "--evidence-dir is required"
[ "$(uname -s)" = Darwin ] || die "release sign-off requires macOS"
[ -n "${HOME:-}" ] && [ "${HOME#/}" != "$HOME" ] || die "HOME must be absolute"

directory_identity() {
  /usr/bin/stat -f '%d:%i' "$1" 2>/dev/null
}

file_identity() {
  /usr/bin/stat -f '%d:%i' "$1" 2>/dev/null
}

file_mode() {
  /usr/bin/stat -f '%Lp' "$1" 2>/dev/null
}

file_owner() {
  /usr/bin/stat -f '%u' "$1" 2>/dev/null
}

file_sha256() {
  /usr/bin/shasum -a 256 "$1" | /usr/bin/awk '{print $1}'
}

require_physical_directory() {
  local path="$1"
  local description="$2"
  local physical

  [ "${path#/}" != "$path" ] || die "$description must be absolute"
  [ -d "$path" ] && [ ! -L "$path" ] || die "$description must be a physical directory: $path"
  physical="$(cd "$path" && pwd -P)"
  [ "$physical" = "$path" ] || die "$description must be canonical and contain no symlinked component: $path"
}

require_physical_file() {
  local path="$1"
  local description="$2"

  [ "${path#/}" != "$path" ] || die "$description must be absolute"
  require_physical_directory "$(dirname "$path")" "$description parent"
  [ -f "$path" ] && [ ! -L "$path" ] || die "$description must be a regular non-symlink file: $path"
}

require_private_evidence_directory() {
  require_physical_directory "$EVIDENCE_DIR" "evidence directory"
  [ "$(file_owner "$EVIDENCE_DIR")" = "$(id -u)" ] || die "evidence directory must be owned by the current user"
  [ "$(file_mode "$EVIDENCE_DIR")" = 700 ] || die "evidence directory mode must be exactly 0700"
  case "$EVIDENCE_DIR/" in
    "$REPO/"*) die "evidence directory must be outside the source worktree" ;;
  esac
}

plist_value() {
  /usr/libexec/PlistBuddy -c "Print :$2" "$1" 2>/dev/null
}

assert_no_plist_value() {
  if plist_value "$1" "$2" >/dev/null; then
    die "$3 has an unexpected $2 value"
  fi
}

cleanup_stage() {
  local status=$?
  trap - EXIT HUP INT TERM
  if [ -n "$STAGE_DIR" ]; then
    if [ -d "$STAGE_DIR" ] && [ ! -L "$STAGE_DIR" ] && \
       [ "$(cd "$STAGE_DIR" 2>/dev/null && pwd -P)" = "$STAGE_DIR" ] && \
       [ "$(dirname "$STAGE_DIR")" = "$EVIDENCE_DIR" ] && \
       [ "$(directory_identity "$STAGE_DIR")" = "$STAGE_DIR_ID" ]; then
      if /bin/rm -rf "$STAGE_DIR"; then
        fsync_directory "$EVIDENCE_DIR" || status=1
      else
        status=1
      fi
    else
      printf 'release-signoff: staging evidence preserved after an identity change: %s\n' "$STAGE_DIR" >&2
      status=1
    fi
  fi
  exit "$status"
}

inspect_current_facts() {
  local git_top
  local git_status
  local daemon_label digest_label daemon_working digest_working
  local daemon_capture daemon_node digest_node daemon_cli digest_cli
  local daemon_root digest_root
  local runtime_values tool_candidate
  local authorization_output authorization_code

  require_physical_directory "$REPO" "source repository"
  require_physical_directory "$REPO/scripts" "source scripts directory"
  require_physical_file "$REPO/scripts/release-signoff" "release-signoff entrypoint"
  require_physical_file "$RUNTIME_CONTRACT" "runtime requirements contract"

  git_top="$(/usr/bin/git -C "$REPO" rev-parse --show-toplevel 2>/dev/null)" || \
    die "source directory is not a Git worktree"
  [ "$git_top" = "$REPO" ] || die "source repository is not the physical Git worktree root"
  git_status="$(/usr/bin/git -C "$REPO" status --porcelain=v1 --untracked-files=all)"
  [ -z "$git_status" ] || die "source worktree is dirty; commit or remove every tracked and untracked change first"
  RELEASE_HEAD="$(/usr/bin/git -C "$REPO" rev-parse HEAD)"
  [[ "$RELEASE_HEAD" =~ ^[0-9a-f]{40}$ ]] || die "Git did not return a full commit identity"

  require_physical_directory "$HOME" "HOME"
  [ "$(file_owner "$HOME")" = "$(id -u)" ] || die "HOME must be owned by the current user"
  require_physical_directory "$HOME/Library" "HOME/Library"
  AGENT_DIR="$HOME/Library/LaunchAgents"
  require_physical_directory "$AGENT_DIR" "HOME/Library/LaunchAgents"
  DAEMON_PLIST="$AGENT_DIR/io.openmurmur.daemon.plist"
  DIGEST_PLIST="$AGENT_DIR/io.openmurmur.digest.plist"
  require_physical_file "$DAEMON_PLIST" "installed daemon plist"
  require_physical_file "$DIGEST_PLIST" "installed digest plist"
  /usr/bin/plutil -lint "$DAEMON_PLIST" >/dev/null || die "installed daemon plist is invalid"
  /usr/bin/plutil -lint "$DIGEST_PLIST" >/dev/null || die "installed digest plist is invalid"

  daemon_label="$(plist_value "$DAEMON_PLIST" Label)" || die "installed daemon plist has no Label"
  digest_label="$(plist_value "$DIGEST_PLIST" Label)" || die "installed digest plist has no Label"
  [ "$daemon_label" = io.openmurmur.daemon ] || die "installed daemon plist has the wrong label"
  [ "$digest_label" = io.openmurmur.digest ] || die "installed digest plist has the wrong label"

  daemon_capture="$(plist_value "$DAEMON_PLIST" ProgramArguments:0)" || die "daemon capture supervisor is missing"
  [ "$(plist_value "$DAEMON_PLIST" ProgramArguments:1)" = --supervise-daemon ] || \
    die "daemon supervisor mode is missing"
  daemon_node="$(plist_value "$DAEMON_PLIST" ProgramArguments:2)" || die "daemon Node argument is missing"
  digest_node="$(plist_value "$DIGEST_PLIST" ProgramArguments:0)" || die "digest Node argument is missing"
  daemon_cli="$(plist_value "$DAEMON_PLIST" ProgramArguments:3)" || die "daemon CLI argument is missing"
  digest_cli="$(plist_value "$DIGEST_PLIST" ProgramArguments:1)" || die "digest CLI argument is missing"
  [ "$(plist_value "$DIGEST_PLIST" ProgramArguments:2)" = digest ] || die "digest command is not digest"
  [ "$(plist_value "$DIGEST_PLIST" ProgramArguments:3)" = scheduled ] || die "digest subcommand is not scheduled"
  [ "$(plist_value "$DIGEST_PLIST" ProgramArguments:4)" = --root ] || die "digest root flag is missing"
  daemon_root="$(plist_value "$DAEMON_PLIST" ProgramArguments:4)" || die "daemon state root is missing"
  digest_root="$(plist_value "$DIGEST_PLIST" ProgramArguments:5)" || die "digest state root is missing"
  assert_no_plist_value "$DAEMON_PLIST" ProgramArguments:5 "installed daemon plist"
  assert_no_plist_value "$DIGEST_PLIST" ProgramArguments:6 "installed digest plist"
  [ "$daemon_capture" = "$HOME/Applications/OpenMurmur Capture.app/Contents/MacOS/OpenMurmurCapture" ] || \
    die "installed daemon does not use the stable capture supervisor"
  [ "$daemon_node" = "$digest_node" ] || die "installed agents use different Node executables"
  [ "$daemon_cli" = "$digest_cli" ] || die "installed agents use different CLI entries"
  [ "$daemon_root" = "$digest_root" ] || die "installed agents use different state roots"

  daemon_working="$(plist_value "$DAEMON_PLIST" WorkingDirectory)" || die "daemon WorkingDirectory is missing"
  digest_working="$(plist_value "$DIGEST_PLIST" WorkingDirectory)" || die "digest WorkingDirectory is missing"
  [ "$daemon_working" = "$REPO" ] && [ "$digest_working" = "$REPO" ] || \
    die "installed agents do not point at the selected source repository"

  NODE_BIN="$daemon_node"
  CLI_ENTRY="$daemon_cli"
  STATE_ROOT="$daemon_root"
  require_physical_file "$NODE_BIN" "installed Node executable"
  [ -x "$NODE_BIN" ] || die "installed Node is not executable"
  require_physical_file "$CLI_ENTRY" "installed CLI entry"
  [ "$CLI_ENTRY" = "$REPO/src/cli/main.ts" ] || die "installed CLI checkout does not match the selected repository"
  require_physical_directory "$STATE_ROOT" "installed state root"
  [ "$(file_owner "$STATE_ROOT")" = "$(id -u)" ] || die "installed state root must be owned by the current user"
  if [ -n "$REQUESTED_ROOT" ]; then
    require_physical_directory "$REQUESTED_ROOT" "requested state root"
    [ "$REQUESTED_ROOT" = "$STATE_ROOT" ] || die "--root does not match the installed state root"
  fi

  if ! runtime_values="$("$NODE_BIN" --input-type=module - "$RUNTIME_CONTRACT" "$NODE_BIN" 2>&1 <<'NODE'
import { readFileSync } from 'node:fs';

const contract = JSON.parse(readFileSync(process.argv[2], 'utf8'));
const expectedExecutable = process.argv[3];
const versionPattern = /^\d+\.\d+\.\d+$/;
const keys = ['nodeMinimum', 'sqliteMinimum', 'pnpmExact'];
if (contract.schemaVersion !== 1 || keys.some((key) => !versionPattern.test(contract[key]))) {
  throw new Error('invalid runtime requirements contract');
}
function compare(left, right) {
  const a = left.split('.').map(Number);
  const b = right.split('.').map(Number);
  for (let index = 0; index < Math.max(a.length, b.length); index += 1) {
    const delta = (a[index] ?? 0) - (b[index] ?? 0);
    if (delta !== 0) return delta;
  }
  return 0;
}
const sqlite = process.versions.sqlite ?? '0.0.0';
if (process.execPath !== expectedExecutable) throw new Error('installed Node resolved to a different executable');
if (compare(process.versions.node, contract.nodeMinimum) < 0) throw new Error('installed Node is below the runtime floor');
if (compare(sqlite, contract.sqliteMinimum) < 0) throw new Error('installed SQLite is below the runtime floor');
process.stdout.write(`${process.versions.node}\t${sqlite}\t${contract.pnpmExact}`);
NODE
  )"; then
    die "installed runtime is incompatible: $runtime_values"
  fi
  IFS=$'\t' read -r NODE_VERSION SQLITE_VERSION PNPM_EXACT <<< "$runtime_values"
  [[ "$NODE_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "installed Node returned an invalid version"
  [[ "$SQLITE_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "installed Node returned an invalid SQLite version"
  [[ "$PNPM_EXACT" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "runtime contract returned an invalid pnpm version"

  tool_candidate="$(command -v pnpm 2>/dev/null || true)"
  [ -n "$tool_candidate" ] || die "pnpm $PNPM_EXACT is required for the offline release gates"
  PNPM_BIN="$(canonical_executable "$tool_candidate" "pnpm")"
  PNPM_VERSION="$(PATH="$(dirname "$NODE_BIN"):$PATH" "$PNPM_BIN" --version 2>/dev/null)" || \
    die "could not read the pnpm version"
  [ "$PNPM_VERSION" = "$PNPM_EXACT" ] || die "pnpm $PNPM_VERSION found; release verification requires exactly $PNPM_EXACT"
  PNPM_NODE="$(PATH="$(dirname "$NODE_BIN"):$PATH" "$PNPM_BIN" exec node -p process.execPath 2>/dev/null)" || \
    die "pnpm could not resolve the installed Node runtime"
  [ "$PNPM_NODE" = "$NODE_BIN" ] || die "pnpm scripts would use $PNPM_NODE instead of the installed Node $NODE_BIN"

  tool_candidate="$(command -v uv 2>/dev/null || true)"
  [ -n "$tool_candidate" ] || die "uv is required for the offline Python release gate"
  UV_BIN="$(canonical_executable "$tool_candidate" "uv")"
  UV_VERSION_OUTPUT="$("$UV_BIN" --version 2>/dev/null)" || die "could not read the uv version"
  [[ "$UV_VERSION_OUTPUT" =~ ^uv\ [0-9]+\.[0-9]+\.[0-9]+ ]] || die "uv returned an invalid version"

  CAPTURE_CHECK="$REPO/scripts/install-capture-app"
  require_physical_file "$CAPTURE_CHECK" "capture app verifier"
  [ -x "$CAPTURE_CHECK" ] || die "capture app verifier is not executable"
  "$CAPTURE_CHECK" --check >/dev/null || die "installed capture app failed its strict read-only check"
  APPLICATIONS_DIR="$HOME/Applications"
  require_physical_directory "$APPLICATIONS_DIR" "HOME/Applications"
  CAPTURE_APP="$APPLICATIONS_DIR/OpenMurmur Capture.app"
  require_physical_directory "$CAPTURE_APP" "installed capture app"
  require_physical_directory "$CAPTURE_APP/Contents" "installed capture Contents"
  require_physical_directory "$CAPTURE_APP/Contents/MacOS" "installed capture MacOS directory"
  CAPTURE_EXECUTABLE="$CAPTURE_APP/Contents/MacOS/OpenMurmurCapture"
  require_physical_file "$CAPTURE_EXECUTABLE" "installed capture executable"
  [ -x "$CAPTURE_EXECUTABLE" ] || die "installed capture executable is not executable"
  CAPTURE_SOURCE_DIGEST="$("$CAPTURE_EXECUTABLE" --source-digest 2>/dev/null)" || \
    die "installed capture helper did not report its source digest"
  [[ "$CAPTURE_SOURCE_DIGEST" =~ ^[0-9a-f]{64}$ ]] || die "installed capture helper returned an invalid source digest"
  if authorization_output="$("$CAPTURE_EXECUTABLE" --authorization-status 2>&1)"; then
    authorization_code=0
  else
    authorization_code=$?
  fi
  [ "$authorization_code" -eq 0 ] && \
    [ "$authorization_output" = '{"authorized":true,"status":"authorized"}' ] || \
    die "installed capture helper is not authorized under its fixed non-prompting status contract"
  CAPTURE_AUTHORIZATION_STATUS=authorized

  REPO_ID="$(directory_identity "$REPO")"
  CLI_ID="$(file_identity "$CLI_ENTRY")"
  CLI_SHA256="$(file_sha256 "$CLI_ENTRY")"
  NODE_ID="$(file_identity "$NODE_BIN")"
  NODE_SHA256="$(file_sha256 "$NODE_BIN")"
  PNPM_ID="$(file_identity "$PNPM_BIN")"
  PNPM_SHA256="$(file_sha256 "$PNPM_BIN")"
  UV_ID="$(file_identity "$UV_BIN")"
  UV_SHA256="$(file_sha256 "$UV_BIN")"
  STATE_ROOT_ID="$(directory_identity "$STATE_ROOT")"
  DAEMON_PLIST_ID="$(file_identity "$DAEMON_PLIST")"
  DAEMON_PLIST_SHA256="$(file_sha256 "$DAEMON_PLIST")"
  DAEMON_PLIST_MODE="$(file_mode "$DAEMON_PLIST")"
  DIGEST_PLIST_ID="$(file_identity "$DIGEST_PLIST")"
  DIGEST_PLIST_SHA256="$(file_sha256 "$DIGEST_PLIST")"
  DIGEST_PLIST_MODE="$(file_mode "$DIGEST_PLIST")"
  CAPTURE_EXECUTABLE_ID="$(file_identity "$CAPTURE_EXECUTABLE")"
  CAPTURE_EXECUTABLE_SHA256="$(file_sha256 "$CAPTURE_EXECUTABLE")"
  EVIDENCE_DIR_ID="$(directory_identity "$EVIDENCE_DIR")"
  D120_REFERENCE="$EVIDENCE_DIR/D120.reference.json"
  D121_REFERENCE="$EVIDENCE_DIR/D121.reference.json"
  D122_REFERENCE="$EVIDENCE_DIR/D122.reference.json"
}

canonical_executable() {
  local candidate="$1"
  local description="$2"
  local resolved

  [ "${candidate#/}" != "$candidate" ] || die "$description executable must resolve to an absolute path"
  require_physical_directory "$(dirname "$candidate")" "$description launcher parent"
  [ -x "$candidate" ] || die "$description launcher is not executable: $candidate"
  resolved="$("$NODE_BIN" --input-type=module - "$candidate" <<'NODE'
import { realpathSync } from 'node:fs';
process.stdout.write(realpathSync(process.argv[2]));
NODE
  )" || die "could not resolve the $description executable"
  require_physical_file "$resolved" "$description executable"
  [ -x "$resolved" ] || die "$description executable is not executable: $resolved"
  printf '%s\n' "$resolved"
}

capture_fact_args() {
  FACT_ARGS=(
    "$RELEASE_HEAD" "$REPO" "$REPO_ID" "$CLI_ENTRY" "$CLI_ID" "$CLI_SHA256"
    "$NODE_BIN" "$NODE_ID" "$NODE_SHA256" "$NODE_VERSION" "$SQLITE_VERSION"
    "$PNPM_BIN" "$PNPM_ID" "$PNPM_SHA256" "$PNPM_VERSION"
    "$UV_BIN" "$UV_ID" "$UV_SHA256" "$UV_VERSION_OUTPUT"
    "$STATE_ROOT" "$STATE_ROOT_ID"
    "$DAEMON_PLIST" "$DAEMON_PLIST_ID" "$DAEMON_PLIST_SHA256" "$DAEMON_PLIST_MODE"
    "$DIGEST_PLIST" "$DIGEST_PLIST_ID" "$DIGEST_PLIST_SHA256" "$DIGEST_PLIST_MODE"
    "$CAPTURE_EXECUTABLE" "$CAPTURE_EXECUTABLE_ID" "$CAPTURE_EXECUTABLE_SHA256"
    "$CAPTURE_SOURCE_DIGEST" "$CAPTURE_AUTHORIZATION_STATUS"
    "$EVIDENCE_DIR" "$EVIDENCE_DIR_ID" "$D120_REFERENCE" "$D121_REFERENCE" "$D122_REFERENCE"
  )
}

revalidate_snapshot() {
  local index

  inspect_current_facts
  capture_fact_args
  [ "${#FACT_ARGS[@]}" -eq "${#INITIAL_FACT_ARGS[@]}" ] || die "release provenance changed during inspection"
  index=0
  while [ "$index" -lt "${#FACT_ARGS[@]}" ]; do
    [ "${FACT_ARGS[$index]}" = "${INITIAL_FACT_ARGS[$index]}" ] || \
      die "release provenance changed during inspection"
    index=$((index + 1))
  done
}

run_release_gate() {
  local gate="$1"
  local stdout_file="$STAGE_DIR/$gate.stdout"
  local stderr_file="$STAGE_DIR/$gate.stderr"
  local exit_code
  shift

  set +e
  (cd "$REPO" && "$@") > "$stdout_file" 2> "$stderr_file"
  exit_code=$?
  set -e
  chmod 0600 "$stdout_file" "$stderr_file"
  case "$gate" in
    pnpm-install)
      PNPM_INSTALL_STDOUT_SHA="$(file_sha256 "$stdout_file")"
      PNPM_INSTALL_STDERR_SHA="$(file_sha256 "$stderr_file")"
      PNPM_INSTALL_EXIT="$exit_code"
      ;;
    node-check)
      NODE_CHECK_STDOUT_SHA="$(file_sha256 "$stdout_file")"
      NODE_CHECK_STDERR_SHA="$(file_sha256 "$stderr_file")"
      NODE_CHECK_EXIT="$exit_code"
      ;;
    python-pytest)
      PYTHON_PYTEST_STDOUT_SHA="$(file_sha256 "$stdout_file")"
      PYTHON_PYTEST_STDERR_SHA="$(file_sha256 "$stderr_file")"
      PYTHON_PYTEST_EXIT="$exit_code"
      ;;
    *) die "internal unknown release gate: $gate" ;;
  esac
  [ "$exit_code" -eq 0 ] || die "$gate failed with exit code $exit_code; no release receipt was published"
}

write_receipt() {
  local output="$1"
  shift
  "$NODE_BIN" --input-type=module - "$output" "$@" <<'NODE'
import { closeSync, fsyncSync, openSync, writeFileSync } from 'node:fs';

const [
  output, releaseCommit, repositoryPath,
  nodePath, nodeIdentity, nodeSha256, nodeVersion, sqliteVersion,
  pnpmPath, pnpmIdentity, pnpmSha256, pnpmVersion,
  uvPath, uvIdentity, uvSha256, uvVersion,
  pnpmInstallStdout, pnpmInstallStderr, pnpmInstallExit,
  nodeCheckStdout, nodeCheckStderr, nodeCheckExit,
  pythonStdout, pythonStderr, pythonExit,
] = process.argv.slice(2);
const receipt = {
  schemaVersion: 1,
  releaseCommit,
  repositoryPath,
  tools: {
    node: { path: nodePath, identity: nodeIdentity, sha256: nodeSha256, version: nodeVersion, sqliteVersion },
    pnpm: { path: pnpmPath, identity: pnpmIdentity, sha256: pnpmSha256, version: pnpmVersion },
    uv: { path: uvPath, identity: uvIdentity, sha256: uvSha256, version: uvVersion },
  },
  gates: [
    {
      id: 'pnpm-install',
      command: [pnpmPath, 'install', '--offline', '--frozen-lockfile'],
      cwd: repositoryPath,
      environment: { nodePathFirst: nodePath, network: 'offline' },
      stdoutSha256: pnpmInstallStdout,
      stderrSha256: pnpmInstallStderr,
      exitCode: Number(pnpmInstallExit),
    },
    {
      id: 'node-check',
      command: [pnpmPath, 'run', 'check'],
      cwd: repositoryPath,
      environment: { nodePathFirst: nodePath, network: 'not-used' },
      stdoutSha256: nodeCheckStdout,
      stderrSha256: nodeCheckStderr,
      exitCode: Number(nodeCheckExit),
    },
    {
      id: 'python-pytest',
      command: [uvPath, 'run', '--offline', '--no-sync', '--project', 'python/openmurmur_audio', 'pytest'],
      cwd: repositoryPath,
      environment: { UV_OFFLINE: '1', UV_PROJECT_ENVIRONMENT: 'unset', network: 'offline' },
      stdoutSha256: pythonStdout,
      stderrSha256: pythonStderr,
      exitCode: Number(pythonExit),
    },
  ],
};
writeFileSync(output, `${JSON.stringify(receipt, null, 2)}\n`, { flag: 'wx', mode: 0o600 });
const descriptor = openSync(output, 'r');
try { fsyncSync(descriptor); } finally { closeSync(descriptor); }
NODE
}

verify_receipt() {
  local receipt="$1"
  "$NODE_BIN" --input-type=module - \
    "$receipt" "$RELEASE_HEAD" "$REPO" \
    "$NODE_BIN" "$NODE_ID" "$NODE_SHA256" "$NODE_VERSION" "$SQLITE_VERSION" \
    "$PNPM_BIN" "$PNPM_ID" "$PNPM_SHA256" "$PNPM_VERSION" \
    "$UV_BIN" "$UV_ID" "$UV_SHA256" "$UV_VERSION_OUTPUT" <<'NODE'
import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';

const [
  receiptPath, releaseCommit, repositoryPath,
  nodePath, nodeIdentity, nodeSha256, nodeVersion, sqliteVersion,
  pnpmPath, pnpmIdentity, pnpmSha256, pnpmVersion,
  uvPath, uvIdentity, uvSha256, uvVersion,
] = process.argv.slice(2);
const raw = readFileSync(receiptPath, 'utf8');
if (Buffer.byteLength(raw) > 64 * 1024) throw new Error('release receipt exceeds the bounded v1 size');
const actual = JSON.parse(raw);
assert.equal(raw, `${JSON.stringify(actual, null, 2)}\n`, 'release receipt is not canonical v1 JSON');
assert.equal(actual.schemaVersion, 1);
assert.equal(actual.releaseCommit, releaseCommit);
assert.equal(actual.repositoryPath, repositoryPath);
assert.deepEqual(actual.tools, {
  node: { path: nodePath, identity: nodeIdentity, sha256: nodeSha256, version: nodeVersion, sqliteVersion },
  pnpm: { path: pnpmPath, identity: pnpmIdentity, sha256: pnpmSha256, version: pnpmVersion },
  uv: { path: uvPath, identity: uvIdentity, sha256: uvSha256, version: uvVersion },
});
const expectedCommands = [
  {
    id: 'pnpm-install', command: [pnpmPath, 'install', '--offline', '--frozen-lockfile'],
    environment: { nodePathFirst: nodePath, network: 'offline' },
  },
  {
    id: 'node-check', command: [pnpmPath, 'run', 'check'],
    environment: { nodePathFirst: nodePath, network: 'not-used' },
  },
  {
    id: 'python-pytest',
    command: [uvPath, 'run', '--offline', '--no-sync', '--project', 'python/openmurmur_audio', 'pytest'],
    environment: { UV_OFFLINE: '1', UV_PROJECT_ENVIRONMENT: 'unset', network: 'offline' },
  },
];
assert.equal(actual.gates?.length, expectedCommands.length);
const digestPattern = /^[0-9a-f]{64}$/;
for (let index = 0; index < expectedCommands.length; index += 1) {
  const gate = actual.gates[index];
  const expected = expectedCommands[index];
  assert.equal(gate.id, expected.id);
  assert.deepEqual(gate.command, expected.command);
  assert.equal(gate.cwd, repositoryPath);
  assert.deepEqual(gate.environment, expected.environment);
  assert.match(gate.stdoutSha256, digestPattern);
  assert.match(gate.stderrSha256, digestPattern);
  assert.equal(gate.exitCode, 0);
  assert.deepEqual(Object.keys(gate), [
    'id', 'command', 'cwd', 'environment', 'stdoutSha256', 'stderrSha256', 'exitCode',
  ]);
}
assert.deepEqual(Object.keys(actual), [
  'schemaVersion', 'releaseCommit', 'repositoryPath', 'tools', 'gates',
]);
NODE
}

write_manifest() {
  local output="$1"
  shift
  "$NODE_BIN" --input-type=module - "$output" "$@" <<'NODE'
import { closeSync, fsyncSync, openSync, writeFileSync } from 'node:fs';

const [
  output, releaseCommit, repositoryPath, repositoryIdentity, cliPath, cliIdentity, cliSha256,
  nodePath, nodeIdentity, nodeSha256, nodeVersion, sqliteVersion,
  pnpmPath, pnpmIdentity, pnpmSha256, pnpmVersion,
  uvPath, uvIdentity, uvSha256, uvVersion,
  stateRootPath, stateRootIdentity,
  daemonPath, daemonIdentity, daemonSha256, daemonMode,
  digestPath, digestIdentity, digestSha256, digestMode,
  capturePath, captureIdentity, captureSha256, captureSourceDigest, captureAuthorizationStatus,
  evidenceDirectory, evidenceDirectoryIdentity, d120, d121, d122,
  receiptPath, receiptIdentity, receiptSha256, receiptReleaseCommit,
] = process.argv.slice(2);
const manifest = {
  schemaVersion: 2,
  releaseCommit,
  repository: { path: repositoryPath, identity: repositoryIdentity, cliPath, cliIdentity, cliSha256 },
  runtime: {
    nodePath, nodeIdentity, nodeSha256, nodeVersion, sqliteVersion,
    pnpmPath, pnpmIdentity, pnpmSha256, pnpmVersion,
    uvPath, uvIdentity, uvSha256, uvVersion,
  },
  stateRoot: { path: stateRootPath, identity: stateRootIdentity },
  plists: {
    daemon: { path: daemonPath, identity: daemonIdentity, sha256: daemonSha256, mode: daemonMode },
    digest: { path: digestPath, identity: digestIdentity, sha256: digestSha256, mode: digestMode },
  },
  capture: {
    executablePath: capturePath,
    executableIdentity: captureIdentity,
    executableSha256: captureSha256,
    sourceDigest: captureSourceDigest,
    authorizationStatus: captureAuthorizationStatus,
  },
  verificationReceipt: { path: receiptPath, identity: receiptIdentity, sha256: receiptSha256, releaseCommit: receiptReleaseCommit },
  evidenceDirectory: { path: evidenceDirectory, identity: evidenceDirectoryIdentity },
  requiredLiveEvidenceReferences: { D120: d120, D121: d121, D122: d122 },
};
writeFileSync(output, `${JSON.stringify(manifest, null, 2)}\n`, { flag: 'wx', mode: 0o600 });
const descriptor = openSync(output, 'r');
try { fsyncSync(descriptor); } finally { closeSync(descriptor); }
NODE
}

write_commit_marker() {
  local output="$1"
  shift
  "$NODE_BIN" --input-type=module - "$output" "$@" <<'NODE'
import { closeSync, fsyncSync, openSync, writeFileSync } from 'node:fs';

const [
  output, releaseCommit,
  receiptPath, receiptIdentity, receiptSha256,
  manifestPath, manifestIdentity, manifestSha256,
] = process.argv.slice(2);
const marker = {
  schemaVersion: 1,
  releaseCommit,
  receipt: { path: receiptPath, identity: receiptIdentity, sha256: receiptSha256 },
  manifest: { path: manifestPath, identity: manifestIdentity, sha256: manifestSha256 },
};
writeFileSync(output, `${JSON.stringify(marker, null, 2)}\n`, { flag: 'wx', mode: 0o600 });
const descriptor = openSync(output, 'r');
try { fsyncSync(descriptor); } finally { closeSync(descriptor); }
NODE
}

verify_commit_marker() {
  local marker="$1"
  shift
  "$NODE_BIN" --input-type=module - "$marker" "$@" <<'NODE'
import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';

const [
  markerPath, releaseCommit,
  receiptPath, receiptIdentity, receiptSha256,
  manifestPath, manifestIdentity, manifestSha256,
] = process.argv.slice(2);
const expected = {
  schemaVersion: 1,
  releaseCommit,
  receipt: { path: receiptPath, identity: receiptIdentity, sha256: receiptSha256 },
  manifest: { path: manifestPath, identity: manifestIdentity, sha256: manifestSha256 },
};
const raw = readFileSync(markerPath, 'utf8');
if (Buffer.byteLength(raw) > 16 * 1024) throw new Error('release commit marker exceeds the bounded v1 size');
const actual = JSON.parse(raw);
assert.equal(raw, `${JSON.stringify(actual, null, 2)}\n`, 'release commit marker is not canonical v1 JSON');
assert.deepEqual(actual, expected, 'release commit marker no longer binds the exact evidence set');
NODE
}

verify_manifest() {
  local manifest="$1"
  shift
  "$NODE_BIN" --input-type=module - "$manifest" "$@" <<'NODE'
import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';

const [
  manifestPath, releaseCommit, repositoryPath, repositoryIdentity, cliPath, cliIdentity, cliSha256,
  nodePath, nodeIdentity, nodeSha256, nodeVersion, sqliteVersion,
  pnpmPath, pnpmIdentity, pnpmSha256, pnpmVersion,
  uvPath, uvIdentity, uvSha256, uvVersion,
  stateRootPath, stateRootIdentity,
  daemonPath, daemonIdentity, daemonSha256, daemonMode,
  digestPath, digestIdentity, digestSha256, digestMode,
  capturePath, captureIdentity, captureSha256, captureSourceDigest, captureAuthorizationStatus,
  evidenceDirectory, evidenceDirectoryIdentity, d120, d121, d122,
  receiptPath, receiptIdentity, receiptSha256, receiptReleaseCommit,
] = process.argv.slice(2);
const expected = {
  schemaVersion: 2,
  releaseCommit,
  repository: { path: repositoryPath, identity: repositoryIdentity, cliPath, cliIdentity, cliSha256 },
  runtime: {
    nodePath, nodeIdentity, nodeSha256, nodeVersion, sqliteVersion,
    pnpmPath, pnpmIdentity, pnpmSha256, pnpmVersion,
    uvPath, uvIdentity, uvSha256, uvVersion,
  },
  stateRoot: { path: stateRootPath, identity: stateRootIdentity },
  plists: {
    daemon: { path: daemonPath, identity: daemonIdentity, sha256: daemonSha256, mode: daemonMode },
    digest: { path: digestPath, identity: digestIdentity, sha256: digestSha256, mode: digestMode },
  },
  capture: {
    executablePath: capturePath,
    executableIdentity: captureIdentity,
    executableSha256: captureSha256,
    sourceDigest: captureSourceDigest,
    authorizationStatus: captureAuthorizationStatus,
  },
  verificationReceipt: { path: receiptPath, identity: receiptIdentity, sha256: receiptSha256, releaseCommit: receiptReleaseCommit },
  evidenceDirectory: { path: evidenceDirectory, identity: evidenceDirectoryIdentity },
  requiredLiveEvidenceReferences: { D120: d120, D121: d121, D122: d122 },
};
const raw = readFileSync(manifestPath, 'utf8');
if (Buffer.byteLength(raw) > 64 * 1024) throw new Error('manifest exceeds the bounded v2 size');
const actual = JSON.parse(raw);
assert.equal(raw, `${JSON.stringify(actual, null, 2)}\n`, 'manifest is not canonical v2 JSON');
assert.deepEqual(actual, expected, 'manifest no longer matches the selected source and installation');
NODE
}

fsync_directory() {
  "$NODE_BIN" --input-type=module - "$1" <<'NODE'
import { closeSync, fsyncSync, openSync } from 'node:fs';

const descriptor = openSync(process.argv[2], 'r');
try { fsyncSync(descriptor); } finally { closeSync(descriptor); }
NODE
}

frozen_private_file_matches() {
  local path="$1"
  local expected_identity="$2"
  local expected_sha256="$3"

  [ -f "$path" ] && [ ! -L "$path" ] && \
    [ "$(file_mode "$path")" = 600 ] && \
    [ "$(file_identity "$path")" = "$expected_identity" ] && \
    [ "$(file_sha256 "$path")" = "$expected_sha256" ]
}

rollback_publication() {
  local complete=1
  local path expected_identity

  if [ ! -d "$EVIDENCE_DIR" ] || [ -L "$EVIDENCE_DIR" ] || \
     [ "$(cd "$EVIDENCE_DIR" 2>/dev/null && pwd -P)" != "$EVIDENCE_DIR" ] || \
     [ "$(file_owner "$EVIDENCE_DIR")" != "$(id -u)" ] || \
     [ "$(file_mode "$EVIDENCE_DIR")" != 700 ] || \
     [ "$(directory_identity "$EVIDENCE_DIR")" != "$EVIDENCE_DIR_ID" ]; then
    printf 'release-signoff: evidence directory changed; published evidence was not removed\n' >&2
    return 1
  fi
  for path in "$COMMIT_MARKER" "$MANIFEST" "$RECEIPT"; do
    if [ "$path" = "$COMMIT_MARKER" ]; then
      expected_identity="${COMMIT_ID:-}"
    elif [ "$path" = "$MANIFEST" ]; then
      expected_identity="$MANIFEST_ID"
    else
      expected_identity="$RECEIPT_ID"
    fi
    if [ -e "$path" ] || [ -L "$path" ]; then
      if [ -n "$expected_identity" ] && [ -f "$path" ] && [ ! -L "$path" ] && \
         [ "$(file_identity "$path")" = "$expected_identity" ]; then
        /bin/rm "$path" || complete=0
      else
        printf 'release-signoff: conflicting evidence preserved at %s\n' "$path" >&2
        complete=0
      fi
    fi
  done
  fsync_directory "$EVIDENCE_DIR" || complete=0
  [ "$complete" -eq 1 ]
}

recover_markerless_publication() {
  local candidate candidate_count=0 recovered_stage="" recovered_stage_id=""
  local staged_receipt staged_manifest staged_commit

  if [ -e "$COMMIT_MARKER" ] || [ -L "$COMMIT_MARKER" ]; then
    die "release evidence commit marker already exists: $COMMIT_MARKER"
  fi
  if [ ! -e "$RECEIPT" ] && [ ! -L "$RECEIPT" ] && \
     [ ! -e "$MANIFEST" ] && [ ! -L "$MANIFEST" ]; then
    return
  fi
  require_physical_file "$RECEIPT" "markerless release verification receipt"
  [ "$(file_owner "$RECEIPT")" = "$(id -u)" ] && [ "$(file_mode "$RECEIPT")" = 600 ] || \
    die "markerless receipt is not exact private release-signoff evidence; it was preserved"
  verify_receipt "$RECEIPT" || die "markerless receipt is ambiguous; it was preserved"
  RECEIPT_ID="$(file_identity "$RECEIPT")"
  RECEIPT_SHA256="$(file_sha256 "$RECEIPT")"
  for candidate in "$EVIDENCE_DIR"/.release-signoff.*; do
    [ -e "$candidate" ] || continue
    if [ -d "$candidate" ] && [ ! -L "$candidate" ] && \
       [ "$(cd "$candidate" 2>/dev/null && pwd -P)" = "$candidate" ] && \
       [ "$(file_owner "$candidate")" = "$(id -u)" ] && \
       [ "$(file_mode "$candidate")" = 700 ]; then
      staged_receipt="$candidate/$RECEIPT_NAME"
      if frozen_private_file_matches "$staged_receipt" "$RECEIPT_ID" "$RECEIPT_SHA256"; then
        candidate_count=$((candidate_count + 1))
        recovered_stage="$candidate"
        recovered_stage_id="$(directory_identity "$candidate")"
      fi
    fi
  done
  [ "$candidate_count" -eq 1 ] || \
    die "markerless receipt has no unique exact release-signoff staging owner; all evidence was preserved"

  staged_receipt="$recovered_stage/$RECEIPT_NAME"
  staged_manifest="$recovered_stage/$MANIFEST_NAME"
  staged_commit="$recovered_stage/$COMMIT_NAME"
  require_physical_file "$staged_manifest" "staged markerless provenance manifest"
  require_physical_file "$staged_commit" "staged markerless release commit marker"
  [ "$(file_owner "$staged_manifest")" = "$(id -u)" ] && \
    [ "$(file_mode "$staged_manifest")" = 600 ] && \
    [ "$(file_owner "$staged_commit")" = "$(id -u)" ] && \
    [ "$(file_mode "$staged_commit")" = 600 ] || \
    die "markerless staging owner is not exact private release-signoff evidence; it was preserved"
  MANIFEST_ID="$(file_identity "$staged_manifest")"
  MANIFEST_SHA256="$(file_sha256 "$staged_manifest")"
  COMMIT_ID="$(file_identity "$staged_commit")"
  COMMIT_SHA256="$(file_sha256 "$staged_commit")"
  MANIFEST_ARGS=("${FACT_ARGS[@]}" "$RECEIPT" "$RECEIPT_ID" "$RECEIPT_SHA256" "$RELEASE_HEAD")
  COMMIT_ARGS=(
    "$RELEASE_HEAD"
    "$RECEIPT" "$RECEIPT_ID" "$RECEIPT_SHA256"
    "$MANIFEST" "$MANIFEST_ID" "$MANIFEST_SHA256"
  )
  verify_receipt "$staged_receipt" || die "markerless staging receipt is ambiguous; it was preserved"
  verify_manifest "$staged_manifest" "${MANIFEST_ARGS[@]}" || \
    die "markerless staging manifest is ambiguous; it was preserved"
  verify_commit_marker "$staged_commit" "${COMMIT_ARGS[@]}" || \
    die "markerless staging commit marker is ambiguous; it was preserved"
  if [ -e "$MANIFEST" ] || [ -L "$MANIFEST" ]; then
    frozen_private_file_matches "$MANIFEST" "$MANIFEST_ID" "$MANIFEST_SHA256" || \
      die "markerless final manifest conflicts with its exact staging owner; it was preserved"
  fi
  revalidate_snapshot
  frozen_private_file_matches "$RECEIPT" "$RECEIPT_ID" "$RECEIPT_SHA256" && \
    frozen_private_file_matches "$staged_receipt" "$RECEIPT_ID" "$RECEIPT_SHA256" && \
    frozen_private_file_matches "$staged_manifest" "$MANIFEST_ID" "$MANIFEST_SHA256" && \
    frozen_private_file_matches "$staged_commit" "$COMMIT_ID" "$COMMIT_SHA256" || \
    die "markerless release evidence changed during recovery; it was preserved"
  verify_receipt "$RECEIPT" || die "markerless receipt changed during recovery; it was preserved"
  verify_manifest "$staged_manifest" "${MANIFEST_ARGS[@]}" || \
    die "markerless manifest changed during recovery; it was preserved"
  verify_commit_marker "$staged_commit" "${COMMIT_ARGS[@]}" || \
    die "markerless commit marker changed during recovery; it was preserved"
  require_private_evidence_directory
  [ "$(directory_identity "$EVIDENCE_DIR")" = "$EVIDENCE_DIR_ID" ] && \
    [ -d "$recovered_stage" ] && [ ! -L "$recovered_stage" ] && \
    [ "$(directory_identity "$recovered_stage")" = "$recovered_stage_id" ] || \
    die "release-signoff boundaries changed during markerless recovery"

  if [ ! -e "$MANIFEST" ] && [ ! -L "$MANIFEST" ]; then
    /bin/ln "$staged_manifest" "$MANIFEST" || \
      die "markerless manifest recovery lost create-if-absent race; evidence was preserved"
  fi
  frozen_private_file_matches "$MANIFEST" "$MANIFEST_ID" "$MANIFEST_SHA256" || \
    die "recovered markerless manifest does not match its exact staging owner"
  fsync_directory "$EVIDENCE_DIR"
  /bin/ln "$staged_commit" "$COMMIT_MARKER" || \
    die "markerless commit recovery lost create-if-absent race; evidence was preserved"
  frozen_private_file_matches "$COMMIT_MARKER" "$COMMIT_ID" "$COMMIT_SHA256" || \
    die "recovered release commit marker does not match its exact staging owner"
  fsync_directory "$EVIDENCE_DIR"
  frozen_private_file_matches "$RECEIPT" "$RECEIPT_ID" "$RECEIPT_SHA256" && \
    frozen_private_file_matches "$MANIFEST" "$MANIFEST_ID" "$MANIFEST_SHA256" && \
    frozen_private_file_matches "$COMMIT_MARKER" "$COMMIT_ID" "$COMMIT_SHA256" || \
    die "recovered release evidence changed before durable verification"
  verify_commit_marker "$COMMIT_MARKER" "${COMMIT_ARGS[@]}" || \
    die "recovered release evidence failed final commit verification"
  STAGE_DIR="$recovered_stage"
  STAGE_DIR_ID="$recovered_stage_id"
  trap cleanup_stage EXIT
  RECOVERED_COMMIT=true
}

recover_visible_commit() {
  if [ ! -e "$COMMIT_MARKER" ] && [ ! -L "$COMMIT_MARKER" ]; then return; fi

  require_physical_file "$COMMIT_MARKER" "visible release evidence commit marker"
  require_physical_file "$RECEIPT" "visible committed release verification receipt"
  require_physical_file "$MANIFEST" "visible committed release provenance manifest"
  [ "$(file_owner "$COMMIT_MARKER")" = "$(id -u)" ] && \
    [ "$(file_mode "$COMMIT_MARKER")" = 600 ] && \
    [ "$(file_owner "$RECEIPT")" = "$(id -u)" ] && \
    [ "$(file_mode "$RECEIPT")" = 600 ] && \
    [ "$(file_owner "$MANIFEST")" = "$(id -u)" ] && \
    [ "$(file_mode "$MANIFEST")" = 600 ] || \
    die "visible release evidence is not an exact private committed set; all paths were preserved"
  RECEIPT_ID="$(file_identity "$RECEIPT")"
  RECEIPT_SHA256="$(file_sha256 "$RECEIPT")"
  MANIFEST_ID="$(file_identity "$MANIFEST")"
  MANIFEST_SHA256="$(file_sha256 "$MANIFEST")"
  COMMIT_ID="$(file_identity "$COMMIT_MARKER")"
  COMMIT_SHA256="$(file_sha256 "$COMMIT_MARKER")"
  MANIFEST_ARGS=("${FACT_ARGS[@]}" "$RECEIPT" "$RECEIPT_ID" "$RECEIPT_SHA256" "$RELEASE_HEAD")
  COMMIT_ARGS=(
    "$RELEASE_HEAD"
    "$RECEIPT" "$RECEIPT_ID" "$RECEIPT_SHA256"
    "$MANIFEST" "$MANIFEST_ID" "$MANIFEST_SHA256"
  )
  verify_receipt "$RECEIPT" || die "visible release receipt is ambiguous; all evidence was preserved"
  verify_manifest "$MANIFEST" "${MANIFEST_ARGS[@]}" || \
    die "visible release manifest is ambiguous; all evidence was preserved"
  verify_commit_marker "$COMMIT_MARKER" "${COMMIT_ARGS[@]}" || \
    die "visible release commit marker is ambiguous; all evidence was preserved"
  revalidate_snapshot
  frozen_private_file_matches "$RECEIPT" "$RECEIPT_ID" "$RECEIPT_SHA256" && \
    frozen_private_file_matches "$MANIFEST" "$MANIFEST_ID" "$MANIFEST_SHA256" && \
    frozen_private_file_matches "$COMMIT_MARKER" "$COMMIT_ID" "$COMMIT_SHA256" || \
    die "visible release evidence changed during durability recovery; all paths were preserved"
  require_private_evidence_directory
  [ "$(directory_identity "$EVIDENCE_DIR")" = "$EVIDENCE_DIR_ID" ] || \
    die "evidence directory changed during durability recovery"
  fsync_directory "$EVIDENCE_DIR"
  revalidate_snapshot
  frozen_private_file_matches "$RECEIPT" "$RECEIPT_ID" "$RECEIPT_SHA256" && \
    frozen_private_file_matches "$MANIFEST" "$MANIFEST_ID" "$MANIFEST_SHA256" && \
    frozen_private_file_matches "$COMMIT_MARKER" "$COMMIT_ID" "$COMMIT_SHA256" || \
    die "release evidence changed after durability recovery; all paths were preserved"
  verify_receipt "$RECEIPT" || die "release receipt failed durability recovery verification"
  verify_manifest "$MANIFEST" "${MANIFEST_ARGS[@]}" || \
    die "release manifest failed durability recovery verification"
  verify_commit_marker "$COMMIT_MARKER" "${COMMIT_ARGS[@]}" || \
    die "release marker failed durability recovery verification"
  RECOVERED_COMMIT=true
}

publication_failed() {
  local message="$1"

  if rollback_publication; then
    die "$message; exact published evidence was rolled back"
  fi
  die "$message; publication rollback is incomplete and conflicting evidence was preserved"
}

require_private_evidence_directory
inspect_current_facts
MANIFEST="$EVIDENCE_DIR/$MANIFEST_NAME"
RECEIPT="$EVIDENCE_DIR/$RECEIPT_NAME"
COMMIT_MARKER="$EVIDENCE_DIR/$COMMIT_NAME"

# Pass facts to Node directly as argv instead of parsing a generated text record.
capture_fact_args
INITIAL_FACT_ARGS=("${FACT_ARGS[@]}")

if [ "$MODE" = prepare ]; then
  RECOVERED_COMMIT=false
  recover_visible_commit
  if [ "$RECOVERED_COMMIT" = true ]; then
    printf 'Release provenance was already complete and its directory durability was re-proven for %s\n' "$RELEASE_HEAD"
    printf 'Commit marker: %s\n' "$COMMIT_MARKER"
    exit 0
  fi
  recover_markerless_publication
  if [ "$RECOVERED_COMMIT" = true ]; then
    printf 'Release provenance recovered and committed for %s\n' "$RELEASE_HEAD"
    printf 'Commit marker: %s\n' "$COMMIT_MARKER"
    exit 0
  fi
  [ ! -e "$MANIFEST" ] && [ ! -L "$MANIFEST" ] || die "provenance manifest already exists: $MANIFEST"
  [ ! -e "$RECEIPT" ] && [ ! -L "$RECEIPT" ] || die "release verification receipt already exists: $RECEIPT"
  [ ! -e "$COMMIT_MARKER" ] && [ ! -L "$COMMIT_MARKER" ] || die "release evidence commit marker already exists: $COMMIT_MARKER"
  STAGE_DIR="$(mktemp -d "$EVIDENCE_DIR/.release-signoff.XXXXXX")"
  chmod 0700 "$STAGE_DIR"
  STAGE_DIR_ID="$(directory_identity "$STAGE_DIR")"
  trap cleanup_stage EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  run_release_gate pnpm-install /usr/bin/env \
    "PATH=$(dirname "$NODE_BIN"):$PATH" \
    "$PNPM_BIN" install --offline --frozen-lockfile
  run_release_gate node-check /usr/bin/env \
    "PATH=$(dirname "$NODE_BIN"):$PATH" \
    "$PNPM_BIN" run check
  run_release_gate python-pytest /usr/bin/env -u UV_PROJECT_ENVIRONMENT UV_OFFLINE=1 \
    "$UV_BIN" run --offline --no-sync --project python/openmurmur_audio pytest
  revalidate_snapshot

  STAGE_RECEIPT="$STAGE_DIR/$RECEIPT_NAME"
  write_receipt "$STAGE_RECEIPT" \
    "$RELEASE_HEAD" "$REPO" \
    "$NODE_BIN" "$NODE_ID" "$NODE_SHA256" "$NODE_VERSION" "$SQLITE_VERSION" \
    "$PNPM_BIN" "$PNPM_ID" "$PNPM_SHA256" "$PNPM_VERSION" \
    "$UV_BIN" "$UV_ID" "$UV_SHA256" "$UV_VERSION_OUTPUT" \
    "$PNPM_INSTALL_STDOUT_SHA" "$PNPM_INSTALL_STDERR_SHA" "$PNPM_INSTALL_EXIT" \
    "$NODE_CHECK_STDOUT_SHA" "$NODE_CHECK_STDERR_SHA" "$NODE_CHECK_EXIT" \
    "$PYTHON_PYTEST_STDOUT_SHA" "$PYTHON_PYTEST_STDERR_SHA" "$PYTHON_PYTEST_EXIT"
  [ -f "$STAGE_RECEIPT" ] && [ ! -L "$STAGE_RECEIPT" ] && [ "$(file_mode "$STAGE_RECEIPT")" = 600 ] || \
    die "staged release receipt is not a private regular file"
  verify_receipt "$STAGE_RECEIPT"
  RECEIPT_ID="$(file_identity "$STAGE_RECEIPT")"
  RECEIPT_SHA256="$(file_sha256 "$STAGE_RECEIPT")"

  STAGE_MANIFEST="$STAGE_DIR/$MANIFEST_NAME"
  MANIFEST_ARGS=("${FACT_ARGS[@]}" "$RECEIPT" "$RECEIPT_ID" "$RECEIPT_SHA256" "$RELEASE_HEAD")
  write_manifest "$STAGE_MANIFEST" "${MANIFEST_ARGS[@]}"
  [ -f "$STAGE_MANIFEST" ] && [ ! -L "$STAGE_MANIFEST" ] && [ "$(file_mode "$STAGE_MANIFEST")" = 600 ] || \
    die "staged manifest is not a private regular file"
  verify_manifest "$STAGE_MANIFEST" "${MANIFEST_ARGS[@]}"
  MANIFEST_ID="$(file_identity "$STAGE_MANIFEST")"
  MANIFEST_SHA256="$(file_sha256 "$STAGE_MANIFEST")"
  STAGE_COMMIT="$STAGE_DIR/$COMMIT_NAME"
  COMMIT_ARGS=(
    "$RELEASE_HEAD"
    "$RECEIPT" "$RECEIPT_ID" "$RECEIPT_SHA256"
    "$MANIFEST" "$MANIFEST_ID" "$MANIFEST_SHA256"
  )
  write_commit_marker "$STAGE_COMMIT" "${COMMIT_ARGS[@]}"
  [ -f "$STAGE_COMMIT" ] && [ ! -L "$STAGE_COMMIT" ] && [ "$(file_mode "$STAGE_COMMIT")" = 600 ] || \
    die "staged release commit marker is not a private regular file"
  verify_commit_marker "$STAGE_COMMIT" "${COMMIT_ARGS[@]}"
  COMMIT_ID="$(file_identity "$STAGE_COMMIT")"
  COMMIT_SHA256="$(file_sha256 "$STAGE_COMMIT")"
  revalidate_snapshot
  verify_receipt "$STAGE_RECEIPT"
  frozen_private_file_matches "$STAGE_RECEIPT" "$RECEIPT_ID" "$RECEIPT_SHA256" || \
    die "staged release receipt changed before publication"
  frozen_private_file_matches "$STAGE_MANIFEST" "$MANIFEST_ID" "$MANIFEST_SHA256" || \
    die "staged provenance manifest changed before publication"
  frozen_private_file_matches "$STAGE_COMMIT" "$COMMIT_ID" "$COMMIT_SHA256" || \
    die "staged release commit marker changed before publication"
  verify_manifest "$STAGE_MANIFEST" "${MANIFEST_ARGS[@]}"
  verify_commit_marker "$STAGE_COMMIT" "${COMMIT_ARGS[@]}"
  require_private_evidence_directory
  [ "$(directory_identity "$EVIDENCE_DIR")" = "$EVIDENCE_DIR_ID" ] || die "evidence directory changed before publication"
  trap 'publication_failed "release evidence publication interrupted by HUP"' HUP
  trap 'publication_failed "release evidence publication interrupted by INT"' INT
  trap 'publication_failed "release evidence publication interrupted by TERM"' TERM
  /bin/ln "$STAGE_RECEIPT" "$RECEIPT" || die "receipt publication lost create-if-absent race"
  frozen_private_file_matches "$RECEIPT" "$RECEIPT_ID" "$RECEIPT_SHA256" || \
    publication_failed "published receipt does not match the frozen bytes"
  if ! /bin/ln "$STAGE_MANIFEST" "$MANIFEST"; then
    publication_failed "manifest publication lost create-if-absent race"
  fi
  frozen_private_file_matches "$MANIFEST" "$MANIFEST_ID" "$MANIFEST_SHA256" || \
    publication_failed "published manifest does not match the frozen bytes"
  fsync_directory "$EVIDENCE_DIR" || publication_failed "could not durably publish release evidence"
  frozen_private_file_matches "$RECEIPT" "$RECEIPT_ID" "$RECEIPT_SHA256" || \
    publication_failed "published receipt changed before durable verification"
  frozen_private_file_matches "$MANIFEST" "$MANIFEST_ID" "$MANIFEST_SHA256" || \
    publication_failed "published manifest changed before durable verification"
  verify_receipt "$RECEIPT" || publication_failed "published receipt failed final verification"
  verify_manifest "$MANIFEST" "${MANIFEST_ARGS[@]}" || \
    publication_failed "published manifest failed final verification"
  /bin/ln "$STAGE_COMMIT" "$COMMIT_MARKER" || \
    publication_failed "release commit marker publication lost create-if-absent race"
  frozen_private_file_matches "$COMMIT_MARKER" "$COMMIT_ID" "$COMMIT_SHA256" || \
    publication_failed "published release commit marker does not match the frozen bytes"
  fsync_directory "$EVIDENCE_DIR" || publication_failed "could not durably commit release evidence"
  frozen_private_file_matches "$RECEIPT" "$RECEIPT_ID" "$RECEIPT_SHA256" && \
    frozen_private_file_matches "$MANIFEST" "$MANIFEST_ID" "$MANIFEST_SHA256" && \
    frozen_private_file_matches "$COMMIT_MARKER" "$COMMIT_ID" "$COMMIT_SHA256" || \
    publication_failed "committed release evidence changed before final verification"
  verify_commit_marker "$COMMIT_MARKER" "${COMMIT_ARGS[@]}" || \
    publication_failed "published release commit marker failed final verification"
  printf 'Release provenance prepared for %s\n' "$RELEASE_HEAD"
  printf 'Offline verification receipt: %s\n' "$RECEIPT"
  printf 'Manifest: %s\n' "$MANIFEST"
  printf 'Commit marker: %s\n' "$COMMIT_MARKER"
else
  require_physical_file "$COMMIT_MARKER" "release evidence commit marker"
  [ "$(file_owner "$COMMIT_MARKER")" = "$(id -u)" ] || die "release commit marker has the wrong owner"
  [ "$(file_mode "$COMMIT_MARKER")" = 600 ] || die "release commit marker mode must be exactly 0600"
  require_physical_file "$RECEIPT" "release verification receipt"
  [ "$(file_owner "$RECEIPT")" = "$(id -u)" ] || die "release verification receipt has the wrong owner"
  [ "$(file_mode "$RECEIPT")" = 600 ] || die "release verification receipt mode must be exactly 0600"
  verify_receipt "$RECEIPT" || die "release verification receipt drift detected"
  RECEIPT_ID="$(file_identity "$RECEIPT")"
  RECEIPT_SHA256="$(file_sha256 "$RECEIPT")"
  require_physical_file "$MANIFEST" "release provenance manifest"
  MANIFEST_ID="$(file_identity "$MANIFEST")"
  MANIFEST_SHA256="$(file_sha256 "$MANIFEST")"
  COMMIT_ARGS=(
    "$RELEASE_HEAD"
    "$RECEIPT" "$RECEIPT_ID" "$RECEIPT_SHA256"
    "$MANIFEST" "$MANIFEST_ID" "$MANIFEST_SHA256"
  )
  verify_commit_marker "$COMMIT_MARKER" "${COMMIT_ARGS[@]}" || die "release evidence is not atomically committed"
  COMMIT_ID="$(file_identity "$COMMIT_MARKER")"
  COMMIT_SHA256="$(file_sha256 "$COMMIT_MARKER")"
  MANIFEST_ARGS=("${FACT_ARGS[@]}" "$RECEIPT" "$RECEIPT_ID" "$RECEIPT_SHA256" "$RELEASE_HEAD")
  [ "$(file_owner "$MANIFEST")" = "$(id -u)" ] || die "release provenance manifest has the wrong owner"
  [ "$(file_mode "$MANIFEST")" = 600 ] || die "release provenance manifest mode must be exactly 0600"
  verify_manifest "$MANIFEST" "${MANIFEST_ARGS[@]}" || die "release provenance drift detected"
  revalidate_snapshot
  [ "$(file_identity "$RECEIPT")" = "$RECEIPT_ID" ] && \
    [ "$(file_sha256 "$RECEIPT")" = "$RECEIPT_SHA256" ] || die "release verification receipt changed during inspection"
  frozen_private_file_matches "$MANIFEST" "$MANIFEST_ID" "$MANIFEST_SHA256" || \
    die "release provenance manifest changed during inspection"
  frozen_private_file_matches "$COMMIT_MARKER" "$COMMIT_ID" "$COMMIT_SHA256" || \
    die "release evidence commit marker changed during inspection"
  verify_receipt "$RECEIPT" || die "release verification receipt drift detected"
  verify_manifest "$MANIFEST" "${MANIFEST_ARGS[@]}" || die "release provenance drift detected"
  verify_commit_marker "$COMMIT_MARKER" "${COMMIT_ARGS[@]}" || die "release evidence commit drift detected"
  printf 'Release provenance still matches %s\n' "$RELEASE_HEAD"
  printf 'D120-D122 remain live until their evidence is audited at the manifest-declared reference paths.\n'
fi
